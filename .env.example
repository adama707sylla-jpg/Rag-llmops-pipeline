# Storage (local: MinIO / prod: Azure Blob)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=arxiv-papers

# Vector DB (local: Qdrant / prod: Azure AI Search)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arxiv-ml

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM — switcher local/prod
LLM_PROVIDER=ollama               # "ollama" en local, "azure" en prod

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Azure OpenAI (prod — laisser vide en local)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01